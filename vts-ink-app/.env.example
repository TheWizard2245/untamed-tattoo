# Copy to .env.local (for local dev) and add the same values in your host's
# environment settings (e.g. Vercel → Project → Settings → Environment Variables).

# Resend (https://resend.com) — sends each booking to Ben with photos attached.
RESEND_API_KEY=
# Where bookings go
BOOKING_EMAIL_TO=ben@example.com
# Sender address. Use "VTS INK <bookings@yourdomain.com>" once a domain is
# verified in Resend; until then Resend's test sender works:
BOOKING_EMAIL_FROM=VTS INK Bookings <onboarding@resend.dev>

# Google Calendar (later): an ICS/JSON feed or a Cloud Function that returns
# { "blocked": ["2026-11-03"] } for ?month=YYYY-MM. Leave blank to skip.
AVAILABILITY_SOURCE_URL=
